    "compilerOptions": {
        "target": "es2025",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"] // 👈 para o TypeScript reconhecer o 'process'
    },
    "include": ["src/**/*", "prisma.config.ts"],
